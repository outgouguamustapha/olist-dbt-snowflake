model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DIM_CUSTOMERS","DIM_PRODUCTS","DIM_DATE","DIM_SELLERS","FCT_ORDER_ITEMS","FCT_ORDERS","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table DIM_CUSTOMERS
ref table DIM_PRODUCTS
ref table DIM_DATE
ref table DIM_SELLERS
ref table FCT_ORDER_ITEMS
ref table FCT_ORDERS
ref table _Measures
ref table DIM_ORDER_STATUS

ref cultureInfo en-US

