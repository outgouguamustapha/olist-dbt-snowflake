/// Centralized DAX measures repository for Olist Marketplace Intelligence Suite
table _Measures
	lineageTag: 3453a8e2-0d89-4f60-a439-c8f732ee839a

	/// Distinct count of unique orders from the orders fact table
	measure 'Total Orders (orders)' = DISTINCTCOUNT( 'FCT_ORDERS'[ORDER_ID] )
		formatString: #,0
		displayFolder: Commercial
		lineageTag: 6395e9ac-b491-497d-9899-39f1d6e20501

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Total gross order amount across all non-canceled orders
	measure 'Total Sales (orders)' = SUM( 'FCT_ORDERS'[ITEMS_GROSS_AMOUNT] )
		formatString: "R$"#,0.00;-"R$"#,0.00;"R$"#,0.00
		displayFolder: Commercial
		lineageTag: a54286eb-86c5-48a5-806b-298acecc3f1c

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	/// Average gross sales amount per order (Total Sales / Total Orders)
	measure 'Average Order Value' = DIVIDE( [Total Sales (orders)], [Total Orders (orders)], 0 )
		formatString: "R$"#,0.00;-"R$"#,0.00;"R$"#,0.00
		displayFolder: Commercial
		lineageTag: 59e7b89c-909f-4818-a9b4-0bfdfd30f87b

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	/// Weighted customer rating (1.00–5.00 scale) based on highest review score per order
	measure 'Average Review Score' = AVERAGE( 'FCT_ORDERS'[HIGHEST_REVIEW_SCORE] )
		displayFolder: Commercial
		lineageTag: 8d002d66-3587-4943-8541-a7bbb0c7237c

		formatStringDefinition = "0.00"" / 5.00"""

	/// Total sales value aggregated from item price lines
	measure 'Total Sales (item)' = SUM( 'FCT_ORDER_ITEMS'[ITEM_PRICE] )
		formatString: "R$"#,0.00;-"R$"#,0.00;"R$"#,0.00
		displayFolder: Commercial
		lineageTag: 66f2fb62-063a-4eba-8a34-367570a98b03

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	/// Hex color highlight (#00A88F for peak sales month, #94A3B8 for other months)
	measure 'Bar Color Peak Month Highlight' = ```
			VAR _CurrentMonthSales = [Total Sales (orders)]
			VAR _MaxMonthSales = 
			    MAXX(
			        ALLSELECTED( DIM_DATE[MONTH_YEAR], DIM_DATE[YEAR_MONTH_SORT_KEY] ),
			        [Total Sales (orders)]
			    )
			RETURN
			    IF( _CurrentMonthSales = _MaxMonthSales && _CurrentMonthSales > 0, "#00A88F", "#94A3B8" )
			```
		formatString: @
		displayFolder: Commercial
		lineageTag: cb64167d-3a31-4ab2-9b9f-685f03b601c5

	/// Sales amount label displayed only for the peak sales month
	measure 'Peak Month Sales Label' = ```
			VAR _CurrentMonthSales = [Total Sales (orders)]
			VAR _MaxMonthSales = 
			    MAXX(
			        ALLSELECTED( DIM_DATE[MONTH_YEAR], DIM_DATE[YEAR_MONTH_SORT_KEY] ),
			        [Total Sales (orders)]
			    )
			RETURN
			    IF( _CurrentMonthSales = _MaxMonthSales && _CurrentMonthSales > 0, _CurrentMonthSales, BLANK() )
			```
		formatString: "R$"#,0.00;-"R$"#,0.00;"R$"#,0.00
		displayFolder: Commercial
		lineageTag: 783ac342-f1db-4700-978c-9e61d60cc782

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	/// Maximum possible review score benchmark (5.0 scale)
	measure 'Max Review score' = "5.0"
		formatString: 0.0
		displayFolder: Commercial
		lineageTag: 5fe4412f-29c1-46a1-b4ef-91c413468970

	/// KPI sub-card subtitle displaying Product GMV and Freight percentage breakdown
	measure 'KPI Sub - Sales Breakdown' = ```
			VAR _ProductSales = [Total Sales (orders)]
			VAR _FreightSales = SUM( 'FCT_ORDERS'[FREIGHT_AMOUNT] )
			VAR _FreightPct   = DIVIDE( _FreightSales, _ProductSales, 0 )
			RETURN
			    "Product GMV: " & FORMAT( _ProductSales, "R$ #,##0.00,,""M""" ) 
			        & " • Freight: " & FORMAT( _FreightPct, "0.0%" )
			```
		formatString: @
		displayFolder: Commercial
		lineageTag: 3b8a3c95-83c5-4b1e-873f-a2e54a10feec

	/// Total count of unique customers registered in the customer dimension
	measure 'Total Customers' = DISTINCTCOUNT( DIM_CUSTOMERS[CUSTOMER_UNIQUE_ID] )
		formatString: 0
		displayFolder: Retention
		lineageTag: e88b69ca-1f72-425a-bd44-1858027d70a5

	/// Distinct count of unique customers who placed at least one order
	measure 'Active Customers' = DISTINCTCOUNT( 'FCT_ORDERS'[CUSTOMER_UNIQUE_ID] )
		formatString: #,0
		displayFolder: Retention
		lineageTag: b0dafe9e-168b-44a2-b8ce-8f7d5a409a66

	/// Percentage of active customers who have made more than one order
	measure 'Repeat Rate' = DIVIDE( [Total Repeat Customers], [Active Customers], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Retention
		lineageTag: c7b30e25-df08-4cf7-8fe8-569e602e97ef

	/// Count of active customers belonging to the Repeat Buyer segment
	measure 'Total Repeat Customers' =
			CALCULATE(
			    [Active Customers],
			    KEEPFILTERS( DIM_CUSTOMERS[CUSTOMER_SEGMENT] = "Repeat Buyer" )
			)
		formatString: #,0
		displayFolder: Retention
		lineageTag: 0c638be5-cffc-48b3-bced-ae165a4fd346

	/// Total order sales revenue generated by repeat buyers
	measure 'Repeat Order Revenue' =
			CALCULATE(
			    [Total Sales (orders)],
			    KEEPFILTERS( DIM_CUSTOMERS[CUSTOMER_SEGMENT] = "Repeat Buyer" )
			)
		formatString: "R$"#,0.00;-"R$"#,0.00;"R$"#,0.00
		displayFolder: Retention
		lineageTag: fcecf1a5-1a01-4d3c-9c9f-a3a5c96d8126

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	/// Total count of order line items sold
	measure 'Total Items' = COUNTROWS( FCT_ORDER_ITEMS )
		formatString: 0
		displayFolder: Commercial
		lineageTag: 477e1914-4058-4564-b7fa-7461ced932c1

	/// Average quantity of items purchased per order
	measure 'Average Items per Order' = DIVIDE( [Total Items], [Total Orders (orders)], 0 )
		formatString: 0.00
		displayFolder: Retention
		lineageTag: b33ab004-3df2-4aac-be44-59d3c63949d1

	/// Distinct count of first-time ordering customers
	measure 'Entry Customers' =
			CALCULATE(
			    DISTINCTCOUNT( 'FCT_ORDERS'[CUSTOMER_UNIQUE_ID] ),
			    KEEPFILTERS( 'FCT_ORDERS'[ORDER_TYPE] = "First Order" ),
			    TREATAS( VALUES( FCT_ORDER_ITEMS[ORDER_ID] ), 'FCT_ORDERS'[ORDER_ID] )
			)
		formatString: #,0
		displayFolder: Retention
		lineageTag: 53159395-2a89-47da-ba9f-729a41e657cf

	/// Count of first-time buyers who transitioned to place 2 or more orders
	measure 'Converted Repeat Buyers' =
			CALCULATE(
			    [Entry Customers],
			    KEEPFILTERS( DIM_CUSTOMERS[LIFETIME_ORDERS_COUNT] >= 2 )
			)
		formatString: #,##0
		displayFolder: Retention
		lineageTag: 799b2c14-f9fe-46a1-9ec1-06739cb8d4b0

	/// Proportion of first-time buyers who transitioned to repeat buyers
	measure 'Entry Repeat Conversion %' = DIVIDE( [Converted Repeat Buyers], [Entry Customers], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Retention
		lineageTag: 75443b95-783c-486c-828f-fcdce9f62522

	/// Formatted label showing active customer count and segment share percentage
	measure 'Active Customers Label' =
			VAR _ActiveCustomers = [Active Customers]
			VAR _AllCustomers = CALCULATE( _ActiveCustomers, REMOVEFILTERS( DIM_CUSTOMERS[ORDER_FREQUENCY_BUCKET] ) )
			VAR _Pct = DIVIDE( _ActiveCustomers, _AllCustomers, 0 )
			RETURN
			    FORMAT( _ActiveCustomers, "#,##0" ) & " (" & FORMAT( _Pct, "0.00%" ) & ")"
		formatString: @
		displayFolder: Retention
		lineageTag: 122de401-606f-46d3-9ba5-2d711d2ef8f6

	/// Count of delivered orders completed within the estimated delivery date
	measure 'On-Time Orders' =
			CALCULATE(
			    [Total Orders (orders)],
			    KEEPFILTERS( 'FCT_ORDERS'[DELIVERY_LEAD_TIME_STATUS] = "On Time" )
			)
		formatString: 0
		displayFolder: Logistics
		lineageTag: c7e8cabf-f612-4224-a98c-c4f88cb22f07

	/// Total count of orders successfully marked as delivered
	measure 'Delivered Orders' =
			CALCULATE(
			    [Total Orders (orders)],
			    KEEPFILTERS( DIM_ORDER_STATUS[ORDER_STATUS] = "delivered" )
			)
		formatString: 0
		displayFolder: Logistics
		lineageTag: 08f2c608-b25c-4c12-88af-d33b0c560578

	/// Percentage of delivered orders that arrived on or before the estimated delivery date
	measure 'On-Time Delivery Rate %' = DIVIDE( [On-Time Orders], [Delivered Orders], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics
		lineageTag: 8e39d977-fd65-4f29-93e9-9ec1ac64a1d2

	/// Average elapsed days between purchase and customer delivery for delivered orders
	measure 'Average Actual Delivery Days' =
			CALCULATE(
			    AVERAGE( 'FCT_ORDERS'[ACTUAL_DELIVERY_DAYS] ),
			    KEEPFILTERS( 'FCT_ORDERS'[ORDER_STATUS] = "delivered" )
			)
		displayFolder: Logistics
		lineageTag: 60f937db-8142-483b-b5ff-6982a9e44358

		formatStringDefinition = "0.00"" days"""

	/// Average variance in days between estimated and actual delivery dates (+ early, - delay)
	measure 'Avg Delivery Variance Days' =
			CALCULATE(
			    AVERAGE( 'FCT_ORDERS'[DELIVERY_DELAY_DAYS] ),
			    KEEPFILTERS( 'FCT_ORDERS'[ORDER_STATUS] = "delivered" )
			)
		displayFolder: Logistics
		lineageTag: a3193660-9e90-4fd3-83af-73a16f772a6e

		formatStringDefinition = "+0.00"" days"";-0.00"" days"";0.00"" days"""

	/// Freight shipping charges as a percentage of total gross order sales
	measure 'Freight Ratio %' = DIVIDE( SUM( FCT_ORDER_ITEMS[FREIGHT_VALUE] ), SUM( 'FCT_ORDERS'[ITEMS_GROSS_AMOUNT] ), 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics
		lineageTag: bbc55541-12cd-464c-908a-4b4000fc6816

	/// Percentage of delivered orders that exceeded the estimated delivery date
	measure 'Late Delivery Rate %' =
			VAR _rate = [On-Time Delivery Rate %]
			RETURN
			    IF( NOT ISBLANK( _rate ), 1 - _rate )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics
		lineageTag: 5358a0e8-4c0d-4798-bc59-6d078345f774

	/// Percentage of dispatched orders where seller handed off package after shipping limit date
	measure 'Seller Late Dispatch Rate %' = ```
			VAR _DispatchedOrders = 
			    CALCULATE(
			        DISTINCTCOUNT( FCT_ORDER_ITEMS[ORDER_ID] ),
			        KEEPFILTERS( FCT_ORDER_ITEMS[SELLER_DISPATCH_STATUS] IN { "Dispatched On Time", "Late Dispatch" } )
			    )
			VAR _LateOrders = 
			    CALCULATE(
			        DISTINCTCOUNT( FCT_ORDER_ITEMS[ORDER_ID] ),
			        KEEPFILTERS( FCT_ORDER_ITEMS[SELLER_DISPATCH_STATUS] = "Late Dispatch" )
			    )
			RETURN
			    DIVIDE( _LateOrders, _DispatchedOrders, 0 )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics
		lineageTag: 5144bc5b-4808-48ff-96d6-ac7b0571934b

	/// Average days taken by sellers to package and transfer items to the carrier
	measure 'Avg Seller Handling Days' =
			CALCULATE(
			    AVERAGE( FCT_ORDER_ITEMS[SELLER_DISPATCH_DAYS] ),
			    KEEPFILTERS( FCT_ORDER_ITEMS[SELLER_DISPATCH_STATUS] <> "Not Dispatched" )
			)
		formatString: 0.00" days"
		displayFolder: Logistics
		lineageTag: 829c6ee2-f770-4ca5-b4bd-5dcc57ce670a

	/// Distinct count of unique orders handled by sellers
	measure 'Seller Orders' = DISTINCTCOUNT( FCT_ORDER_ITEMS[ORDER_ID] )
		formatString: #,0
		displayFolder: Logistics
		lineageTag: 80d877c1-064d-401d-8b47-56b37e6d9195

	/// Average price per item sold excluding freight charges
	measure 'Average Item Price' = AVERAGE( FCT_ORDER_ITEMS[ITEM_PRICE] )
		displayFolder: Operations
		lineageTag: 9aaf4647-d7a4-4d4e-847f-9ead253b3a49

		formatStringDefinition = """R$ ""#,##0.00"

	/// Distinct count of active sellers with sales transactions
	measure 'Active Sellers' = DISTINCTCOUNT( FCT_ORDER_ITEMS[SELLER_ID] )
		formatString: #,0
		displayFolder: Operations
		lineageTag: 31626514-0957-42c2-b697-fd20aadc25f1

	/// Distinct count of unique products (SKUs) sold
	measure 'Active SKUs Sold' = DISTINCTCOUNT( FCT_ORDER_ITEMS[PRODUCT_ID] )
		formatString: #,0
		displayFolder: Operations
		lineageTag: ca4873ff-32b2-4580-9361-4271ee0a7d1b

	/// Total freight cost relative to total product sales amount
	measure 'Freight-to-Price Ratio %' = DIVIDE( SUM( FCT_ORDER_ITEMS[FREIGHT_VALUE] ), SUM( FCT_ORDER_ITEMS[ITEM_PRICE] ), 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Operations
		lineageTag: f76e5433-2de2-4923-9b2b-1c6d550fed2a

	/// Average customer review rating for orders fulfilled by sellers
	measure 'Seller Review Score' =
			CALCULATE(
			    AVERAGE( 'FCT_ORDERS'[AVERAGE_REVIEW_SCORE] ),
			    TREATAS( VALUES( FCT_ORDER_ITEMS[ORDER_ID] ), 'FCT_ORDERS'[ORDER_ID] )
			)
		formatString: 0.00
		displayFolder: Operations
		lineageTag: 92cf2d17-8729-41e0-ab80-1beb4b58ce20

	/// Distinct count of unique orders derived from the order items fact table
	measure 'Total Orders (items)' = DISTINCTCOUNT( FCT_ORDER_ITEMS[ORDER_ID] )
		formatString: #,0
		displayFolder: Commercial
		lineageTag: c33dc3bb-1cfc-410f-a659-6f4f5c28a2dc

	/// Binary filter flag used in drillthrough target pages to propagate item scope to orders
	measure 'Drillthrough Order Filter' =
			CALCULATE(
			    COUNTROWS( 'FCT_ORDERS' ),
			    TREATAS( VALUES( FCT_ORDER_ITEMS[ORDER_ID] ), 'FCT_ORDERS'[ORDER_ID] )
			)
		formatString: 0
		displayFolder: Utility
		lineageTag: dc33e8da-a40c-4589-afc1-0c233407c048

	/// Dynamic header text for drillthrough pages displaying active customer, category, and seller filters
	measure 'Drillthrough Context Title' =
			"Filtered Scope — State: " & SELECTEDVALUE( DIM_CUSTOMERS[CUSTOMER_STATE], "All" ) &
			            "  |  Category: " & SELECTEDVALUE( DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN], "All" ) &
			            "  |  Seller: " & SELECTEDVALUE( DIM_SELLERS[SELLER_ID], "All" )
		formatString: @
		displayFolder: Utility
		lineageTag: b19bfc6b-e864-4e3b-b77a-c5349b739990

	/// Orders counted by seller shipping limit date using the inactive relationship to DIM_DATE
	measure 'Orders by Shipping Limit' =
			CALCULATE(
			    [Total Orders (items)],
			    USERELATIONSHIP( FCT_ORDER_ITEMS[SHIPPING_LIMIT_DATE_KEY], DIM_DATE[DATE_KEY] )
			)
		formatString: #,0
		displayFolder: Logistics
		lineageTag: 44c6cf5b-9286-476c-a573-e69d3be7e5b3

	/// Dynamic executive takeaways summarizing peak revenue month, top geographic market share, and order unit economics
	measure 'Commercial Executive Insight' = ```
				VAR _TopMonthTable =
				    TOPN( 1, ALLSELECTED( DIM_DATE[MONTH_YEAR] ), [Total Sales (orders)], DESC )
				VAR _TopMonthName =
				    MAXX( _TopMonthTable, DIM_DATE[MONTH_YEAR] )
				VAR _TopMonthSales =
				    CALCULATE( [Total Sales (orders)], KEEPFILTERS( _TopMonthTable ) )
				VAR _TopMonthSalesFormatted =
				    IF(
				        _TopMonthSales >= 1000000,
				        FORMAT( _TopMonthSales, "R$ #,##0.00,,\M" ),
				        FORMAT( _TopMonthSales, "R$ #,##0K" )
				    )
				VAR _TotalSales =
				    CALCULATE( [Total Sales (orders)], ALLSELECTED( DIM_CUSTOMERS[CUSTOMER_STATE] ) )
				VAR _TopStateTable =
				    TOPN( 1, ALLSELECTED( DIM_CUSTOMERS[CUSTOMER_STATE] ), [Total Sales (orders)], DESC )
				VAR _TopStateName =
				    MAXX( _TopStateTable, DIM_CUSTOMERS[CUSTOMER_STATE] )
				VAR _TopStateSales =
				    CALCULATE( [Total Sales (orders)], KEEPFILTERS( _TopStateTable ) )
				VAR _TopStateShare =
				    DIVIDE( _TopStateSales, _TotalSales, 0 )
				VAR _AOV =
				    [Average Order Value]
				VAR _ReviewScore =
				    [Average Review Score]
				VAR _Bullet1 =
				    "• Peak Month: " & COALESCE( _TopMonthName, "N/A" ) & " (" & _TopMonthSalesFormatted & ")"
				VAR _Bullet2 =
				    "• Top Market: " & COALESCE( _TopStateName, "N/A" ) & " (" & FORMAT( _TopStateShare, "0.0%" ) & " of GMV)"
				VAR _Bullet3 =
				    "• Economics: " & FORMAT( _AOV, "R$ #,##0.00" ) & " AOV | " & FORMAT( _ReviewScore, "0.00" ) & " / 5.00 ★"
				RETURN
				    _Bullet1 & UNICHAR( 10 ) & UNICHAR( 10 ) &
				    _Bullet2 & UNICHAR( 10 ) & UNICHAR( 10 ) &
				    _Bullet3
			```
		formatString: @
		displayFolder: Commercial
		lineageTag: 47e2c6e5-69c0-4f23-8bd0-8fe7e9136249

	/// Dynamic executive takeaways summarizing customer retention rate, repeat revenue contribution, and top conversion category
	measure 'Retention Executive Insight' = ```
				VAR _RepeatRate =
				    [Repeat Rate]
				VAR _ActiveCustomers =
				    [Active Customers]
				VAR _RepeatRevenue =
				    [Repeat Order Revenue]
				VAR _TotalSales =
				    [Total Sales (orders)]
				VAR _RepeatRevenueShare =
				    DIVIDE( _RepeatRevenue, _TotalSales, 0 )
				VAR _RepeatRevenueFormatted =
				    IF(
				        _RepeatRevenue >= 1000000,
				        FORMAT( _RepeatRevenue, "R$ #,##0.00,,\M" ),
				        FORMAT( _RepeatRevenue, "R$ #,##0K" )
				    )
				VAR _CountQualified =
				    CALCULATE(
				        COUNTROWS(
				            FILTER(
				                ALLSELECTED( DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN] ),
				                NOT ISBLANK( DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN] ) &&
				                [Total Orders (items)] >= 100
				            )
				        )
				    )
				VAR _MinItems =
				    IF( _CountQualified > 0, 100, 1 )
				VAR _CategoryScope =
				    FILTER(
				        ALLSELECTED( DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN] ),
				        NOT ISBLANK( DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN] ) &&
				        [Total Orders (items)] >= _MinItems
				    )
				VAR _TopCategoryTable =
				    TOPN(
				        1,
				        _CategoryScope,
				        CALCULATE(
				            [Repeat Rate],
				            TREATAS( VALUES( FCT_ORDER_ITEMS[ORDER_ID] ), 'FCT_ORDERS'[ORDER_ID] )
				        ),
				        DESC
				    )
				VAR _TopCategoryName =
				    MAXX( _TopCategoryTable, DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN] )
				VAR _TopCategoryRate =
				    CALCULATE(
				        [Repeat Rate],
				        KEEPFILTERS( _TopCategoryTable ),
				        TREATAS( VALUES( FCT_ORDER_ITEMS[ORDER_ID] ), 'FCT_ORDERS'[ORDER_ID] )
				    )
				VAR _Bullet1 =
				    "• Retention Rate: " & FORMAT( _RepeatRate, "0.00%" ) & " across " & FORMAT( _ActiveCustomers, "#,##0" ) & " buyers"
				VAR _Bullet2 =
				    "• Repeat Revenue: " & _RepeatRevenueFormatted & " (" & FORMAT( _RepeatRevenueShare, "0.0%" ) & " of GMV)"
				VAR _Bullet3 =
				    "• Top Category: " & COALESCE( _TopCategoryName, "N/A" ) & " (" & FORMAT( _TopCategoryRate, "0.00%" ) & " repeat rate)"
				RETURN
				    _Bullet1 & UNICHAR( 10 ) & UNICHAR( 10 ) &
				    _Bullet2 & UNICHAR( 10 ) & UNICHAR( 10 ) &
				    _Bullet3
			```
		formatString: @
		displayFolder: Retention
		lineageTag: 9c261c9c-6fc8-4e7b-a689-f61e72cedd40

	/// Dynamic executive takeaways summarizing delivery SLA performance against benchmark, average transit speed variance, and slowest destination state
	measure 'Logistics Executive Insight' = ```
				VAR _SLA =
				    [On-Time Delivery Rate %]
				VAR _SLAVariance =
				    _SLA - 0.90
				VAR _SLAFormatted =
				    FORMAT( _SLA, "0.00%" ) & " (" & IF( _SLAVariance >= 0, "+", "" ) & FORMAT( _SLAVariance * 100, "0.00" ) & " pts vs. 90% SLA)"
				VAR _AvgDays =
				    [Average Actual Delivery Days]
				VAR _VarianceDays =
				    [Avg Delivery Variance Days]
				VAR _VarianceText =
				    IF( _VarianceDays < 0, FORMAT( ABS( _VarianceDays ), "0.00" ) & " days early", FORMAT( _VarianceDays, "0.00" ) & " days late" )
				VAR _CountQualifiedStates =
				    CALCULATE(
				        COUNTROWS(
				            FILTER(
				                ALLSELECTED( DIM_CUSTOMERS[CUSTOMER_STATE] ),
				                NOT ISBLANK( DIM_CUSTOMERS[CUSTOMER_STATE] ) &&
				                [Delivered Orders] >= 50
				            )
				        )
				    )
				VAR _MinOrders =
				    IF( _CountQualifiedStates > 0, 50, 1 )
				VAR _StateScope =
				    FILTER(
				        ALLSELECTED( DIM_CUSTOMERS[CUSTOMER_STATE] ),
				        NOT ISBLANK( DIM_CUSTOMERS[CUSTOMER_STATE] ) &&
				        [Delivered Orders] >= _MinOrders
				    )
				VAR _SlowestStateTable =
				    TOPN(
				        1,
				        _StateScope,
				        [Average Actual Delivery Days],
				        DESC
				    )
				VAR _SlowestStateName =
				    MAXX( _SlowestStateTable, DIM_CUSTOMERS[CUSTOMER_STATE] )
				VAR _SlowestStateDays =
				    CALCULATE( [Average Actual Delivery Days], KEEPFILTERS( _SlowestStateTable ) )
				VAR _Bullet1 =
				    "• SLA Delivery: " & _SLAFormatted
				VAR _Bullet2 =
				    "• Transit Speed: " & FORMAT( _AvgDays, "0.00" ) & " days avg (" & _VarianceText & ")"
				VAR _Bullet3 =
				    "• Slowest State: " & COALESCE( _SlowestStateName, "N/A" ) & " (" & FORMAT( _SlowestStateDays, "0.00" ) & " days transit)"
				RETURN
				    _Bullet1 & UNICHAR( 10 ) & UNICHAR( 10 ) &
				    _Bullet2 & UNICHAR( 10 ) & UNICHAR( 10 ) &
				    _Bullet3
			```
		formatString: @
		displayFolder: Logistics
		lineageTag: 915a0942-bc7c-4c98-ae8d-19fc6debed4d

	/// Dynamic executive takeaways summarizing top product category sales concentration, primary merchant state hub, and seller dispatch SLA compliance
	measure 'Operations Executive Insight' = ```
				VAR _TotalItemSales =
				    CALCULATE( [Total Sales (item)], ALLSELECTED( DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN] ) )
				VAR _TopCategoryTable =
				    TOPN(
				        1,
				        FILTER(
				            ALLSELECTED( DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN] ),
				            NOT ISBLANK( DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN] )
				        ),
				        [Total Sales (item)],
				        DESC
				    )
				VAR _TopCategoryName =
				    MAXX( _TopCategoryTable, DIM_PRODUCTS[PRODUCT_CATEGORY_NAME_EN] )
				VAR _TopCategorySales =
				    CALCULATE( [Total Sales (item)], KEEPFILTERS( _TopCategoryTable ) )
				VAR _TopCategoryShare =
				    DIVIDE( _TopCategorySales, _TotalItemSales, 0 )
				VAR _TotalStateSales =
				    CALCULATE( [Total Sales (item)], ALLSELECTED( DIM_SELLERS[SELLER_STATE] ) )
				VAR _TopSellerStateTable =
				    TOPN(
				        1,
				        FILTER(
				            ALLSELECTED( DIM_SELLERS[SELLER_STATE] ),
				            NOT ISBLANK( DIM_SELLERS[SELLER_STATE] )
				        ),
				        [Total Sales (item)],
				        DESC
				    )
				VAR _TopSellerStateName =
				    MAXX( _TopSellerStateTable, DIM_SELLERS[SELLER_STATE] )
				VAR _TopSellerStateSales =
				    CALCULATE( [Total Sales (item)], KEEPFILTERS( _TopSellerStateTable ) )
				VAR _TopSellerStateShare =
				    DIVIDE( _TopSellerStateSales, _TotalStateSales, 0 )
				VAR _LateDispatchRate =
				    [Seller Late Dispatch Rate %]
				VAR _AvgHandlingDays =
				    [Avg Seller Handling Days]
				VAR _Bullet1 =
				    "• Top Category: " & COALESCE( _TopCategoryName, "N/A" ) & " (" & FORMAT( _TopCategoryShare, "0.0%" ) & " of GMV)"
				VAR _Bullet2 =
				    "• Merchant Hub: " & COALESCE( _TopSellerStateName, "N/A" ) & " (" & FORMAT( _TopSellerStateShare, "0.0%" ) & " of sales)"
				VAR _Bullet3 =
				    "• Dispatch SLA: " & FORMAT( _LateDispatchRate, "0.00%" ) & " late handovers | " & FORMAT( _AvgHandlingDays, "0.00" ) & " days avg"
				RETURN
				    _Bullet1 & UNICHAR( 10 ) & UNICHAR( 10 ) &
				    _Bullet2 & UNICHAR( 10 ) & UNICHAR( 10 ) &
				    _Bullet3
			```
		formatString: @
		displayFolder: Operations
		lineageTag: e7350a09-5a01-4390-a75a-2a744705e645

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

